<?xml version="1.0" encoding="utf-8"?>
<!-- A .NET web.config: XML, although macOS types .config as TOML.
     Lines like key = value below must not be read as INI. -->
<configuration>
  <connectionStrings>
    <add name="Main" connectionString="Server=.;Database=Shop;Trusted_Connection=True" />
  </connectionStrings>
  <appSettings>
    <add key="Environment" value="Production" />
    <add key="Retries" value="3" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
  </system.web>
</configuration>
